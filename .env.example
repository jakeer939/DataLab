# DataLab backend environment variables
# Copy this file to backend/.env and adjust the values for your environment.

# Application
APP_NAME=DataLab
DEBUG=false

# Security — replace with a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite by default, switch to PostgreSQL for production
DATABASE_URL=sqlite:///./backend/datalab.db

# Storage
STORAGE_DIR=./backend/storage
MAX_UPLOAD_BYTES=104857600

# CORS origins allowed for local frontend development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
